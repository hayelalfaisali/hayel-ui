{
  "name": "hayel-ui",
  "version": "0.2.0",
  "description": "Headless, open, and fully customizable React 19 UI library with Tailwind CSS",
  "type": "module",
  "bin": {
    "hayel-ui": "bin/cli.js"
  },
  "files": [
    "bin",
    "src/components/ui",
    "src/lib",
    "src/hooks"
  ],
  "keywords": [
    "react",
    "react19",
    "ui",
    "components",
    "tailwind",
    "headless",
    "shadcn"
  ],
  "author": "Hayel Al-Faisali",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hayelalfaisali/hayel-ui.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^3.2.4"
  }
}
